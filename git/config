[user]
  name = Tim Anema
[include]
	# Allow computer settings so each computer can have different emails and signing keys
  path = ~/.config/git/config.local
[core]
  editor = nvim
  commitGraph = true
 	fsmonitor = true
 	untrackedCache = true
[color]
  ui = true
[init]
  defaultBranch = main
[column]
  ui = auto 
[format]
	pretty=%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset
[help]
  autocorrect = 5
[diff]
  tool = nvim -d
  algorithm = histogram
  colorMoved = dimmed-zebra
  colorMovedWs = ignore-space-change
  mnemonicPrefix = true
  renames = true
	context = 10
[status]
	short = true
[push]
  default = current
  autoSetupRemote = true
  followTags = true
[pull]
  rebase = true
  prune = true
  default = current
[blame]
  coloring = highlightRecent
  date = short
[color "blame"]
  highlightRecent = 237, 20 month ago, 238, 19 month ago, 239, 18 month ago, 240, 17 month ago, 241, 16 month ago, 242, 15 month ago, 243, 14 month ago, 244, 13 month ago, 245, 12 month ago, 246, 11 month ago, 247, 10 month ago, 248, 9 month ago, 249, 8 month ago, 250, 7 month ago, 251, 6 month ago, 252, 5 month ago, 253, 4 month ago, 254, 3 month ago, 231, 2 month ago, 230, 1 month ago, 229, 3 weeks ago, 228, 2 weeks ago, 227, 1 week ago, 226
[merge]
  conflictstyle = zdiff3
[rerere]
  enabled = true
  autoupdate = true
[fetch]
  prune = true
  pruneTags = true
  all = true
[commit]
  gpgsign = true
  verbose = true
[rebase]
  autoStash = true
  autoSquash = true
  updateRefs = true
[gpg]
  program = gpg
[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
[url "ssh://git@gitlab.com/"]
  insteadOf = https://gitlab.com/
[protocol]
  version = 2
[gc]
  writeCommitGraph = true
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
