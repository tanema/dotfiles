#!/usr/bin/env zsh
set -euo pipefail

# rebase is just a simple script to quickly rebase a branch with the default branch
# without having to do the 4+ command shuffle for a very routine task.

if ! git rev-parse --is-inside-work-tree &>/dev/null; then
	echo "⚠️  not a git repo"
	exit 1
fi

stashed=0
current_branch="$(git branch --show-current)"
default_branch="$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')"

if [[ -z "$default_branch" ]]; then
	default_branch="$(git remote show origin | awk '/HEAD branch/ {print $NF}')"
fi

if [[ -z "$default_branch" ]]; then
	echo "⚠️  couldn't determine default branch"
	exit 1
elif [[ -z "$current_branch" ]]; then
	echo "⚠️  detached HEAD, nothing to rebase"
	exit 1
elif [[ "$current_branch" == "$default_branch" ]]; then
	echo "⚠️  on $current_branch, nothing to rebase"
	exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
	echo "📝 stashing local changes"
	git stash push --include-untracked --quiet
	stashed=1
fi

echo "=== Updating $default_branch ==="
git checkout --quiet "$default_branch"
git pull --quiet

echo "=== Rebasing $current_branch onto $default_branch ==="
git checkout --quiet "$current_branch"

if git rebase "$default_branch"; then
	if [[ "$stashed" -eq 1 ]]; then
		echo "📝 restoring stashed changes"
		git stash pop --quiet
	fi
	echo "=== Pushing ==="
	git push --quiet --force-with-lease
	echo "✅ rebase complete"
else
	echo "⚠️ rebase conflicts, resolve then run: git rebase --continue (or --abort)"
	if [[ "$stashed" -eq 1 ]]; then
		echo "your local changes are stashed, run 'git stash pop' after resolving"
	fi
	exit 1
fi
