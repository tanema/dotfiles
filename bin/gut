#!/usr/bin/env bash
set -eo pipefail

current_branch() {
	local ref branch 

	ref=$(git symbolic-ref HEAD 2>/dev/null)
	case $? in
		0)   ;;
		128) return ;;
		*)   ref=$(git rev-parse --short HEAD 2>/dev/null) || return ;;
	esac
   
	echo "${ref#refs/heads/}"
}

branch_dirty() {
	if [[ -n "$(git status --short 2>&1)" ]]; then 
		echo "dirty"
	fi
}

case "$1" in
	branch)
		current_branch
		;;
	dirty)
 		branch_dirty
		;;
	*)
 		cat << EOF
Usage: gut [branch|dirty]

wrapper for simple git operations

branch: outputs the current branch even if in detatched state.
EOF

		;;
esac
