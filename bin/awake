#!/usr/bin/env zsh
set -eo pipefail

action="$1"
pid_file="/tmp/caffeinate.pid"
case "$action" in
	start)
		if [[ -f "$pid_file" ]] && kill -0 "$(cat "$pid_file")" 2>/dev/null; then
			exit 0
		fi
		nohup caffeinate -dis >/dev/null 2>&1 &
		disown
		echo $! >"$pid_file"
		;;
	stop)
		if [[ -f "$pid_file" ]]; then
			kill "$(cat "$pid_file")" 2>/dev/null || true
			rm -f "$pid_file"
		fi
		;;
	*)
 		cat << EOF
Usage: awake [start|stop]

Keeps the Mac awake using caffeinate tracking it with a pid file so the command
does not need to continuously be running.

start: launch caffeinate -i for this session if not already running.
stop:  kill this session's caffeinate so the machine can sleep again.
EOF
		;;
esac
