#!/usr/bin/env zsh
# This is a small script that will get called via the readme command 
# `curl -fsSL https://timanema.com/dot | sh` so it expects that the dotfile directory
# does not exit yet, it will clone it, and then run the install process from the
# dotfiles repo.
xcode-select --install 2>/dev/null || true
mkdir "$HOME/workspace"
git clone https://github.com/tanema/dotfiles.git "$HOME/workspace/dotfiles"
cd "$HOME/workspace/dotfiles"
git remote set-url origin git@github.com:tanema/dotfiles.git
$HOME/workspace/bin/dot install
